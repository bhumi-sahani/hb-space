# Copy to .env.local (git-ignored) and fill in. Never commit real values.
#
# Everything prefixed VITE_ is compiled into the public JavaScript bundle and
# can be read by anyone who loads the site. Only browser-safe values belong here.
# NEVER put a service_role key, sb_secret_ key, database password, or any
# vault passphrase / encryption key in this file.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...) or legacy anon key.
# Safe to expose only because every table and bucket is protected by RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=

# "true" to show passkey sign-in. Passkeys must also be enabled in the
# Supabase dashboard (Authentication -> Passkeys) with the correct RP ID/origins.
VITE_ENABLE_PASSKEYS=false

# Optional: your Supabase plan's file-storage quota in GB, shown in the gallery
# as "used of total" (display only). Default 1 (Free plan). E.g. 100 on Pro.
VITE_STORAGE_LIMIT_GB=1
